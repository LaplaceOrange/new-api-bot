# QQ 机器人 AppID；必填；从 QQ 开放平台机器人管理页面获取；非敏感信息。
QQ_APP_ID=
# QQ 机器人 AppSecret/ClientSecret；必填；用于获取 QQ Access Token；敏感信息。
QQ_APP_SECRET=
# New API 服务根地址；必填；不要包含末尾斜杠，例如 https://example.com；非敏感信息。
NEWAPI_BASE_URL=https://example.com
# New API 管理员系统访问令牌；必填；用于用户查询、签到加额度和管理员额度管理；敏感信息。
NEWAPI_ADMIN_TOKEN=
# 上述 New API 管理员令牌所属用户 ID；必填；作为 New-Api-User 请求头；正整数。
NEWAPI_ADMIN_USER_ID=
# QQ 管理员 OpenID 名单；必填；多个值用英文逗号分隔，支持 union、user、member 标识；敏感信息。
QQ_ADMIN_OPENIDS=
# 本地敏感数据加密密钥；必填；Base64 编码的 32 字节随机值；敏感信息。
BOT_DATA_KEY=
# SMTP 服务器地址；必填；用于发送绑定验证码；例如 smtp.example.com。
SMTP_HOST=
# SMTP 服务器端口；默认 587；应与 SMTP_TLS_MODE 匹配；正整数。
SMTP_PORT=587
# SMTP 登录用户名；必填；通常是完整邮箱地址；敏感信息。
SMTP_USERNAME=
# SMTP 登录密码或授权码；必填；敏感信息。
SMTP_PASSWORD=
# 验证邮件发件人地址；必填；可使用 Name <email@example.com> 格式；敏感信息。
SMTP_FROM=
# SMTP 加密方式；默认 starttls；可选 starttls、tls、none。
SMTP_TLS_MODE=starttls
# 是否启用直接加额度签到；默认 true；可选 true 或 false；非敏感信息。
CHECKIN_ENABLED=true
# 每次签到发放的站点显示额度；默认 1；必须为正十进制数。
CHECKIN_CREDIT=1
# 签到重置周期；默认 daily；可选 daily、weekly、monthly。
CHECKIN_PERIOD=daily
# 签到周期使用的时区；默认 Asia/Shanghai；必须为有效 IANA 时区。
CHECKIN_TIMEZONE=Asia/Shanghai
# 旧版兑换码签到有效期；默认 24h；当前直接加额度模式不使用，仅为兼容旧配置保留；非敏感信息。
CHECKIN_CODE_TTL=24h
# 邮箱绑定验证码有效时间；默认 10m；支持 Go duration 格式。
BIND_CODE_TTL=10m
# 单次验证码最多允许的错误次数；默认 5；正整数。
BIND_CODE_MAX_ATTEMPTS=5
# 每个 QQ 身份及目标账户在限流窗口内最多成功发送的邮件数；默认 2；正整数。
BIND_EMAIL_LIMIT=2
# 邮箱验证码发送限流窗口；默认 1h；支持 Go duration 格式。
BIND_EMAIL_WINDOW=1h
# 旧版单聊与群聊关联码有效时间；默认 10m；当前纯群聊模式不使用，仅为兼容旧配置保留；非敏感信息。
LINK_CODE_TTL=10m
# 单次额度增加允许的最大站点显示额度；默认 1000；必须为正十进制数。
CREDIT_MAX_PER_COMMAND=1000
# bbolt 数据库文件路径；默认 /data/bot.db；目录必须可写并持久化挂载。
DATA_PATH=/data/bot.db
# 健康检查 HTTP 服务监听地址；默认监听全部网卡的 8080 端口。
LISTEN_ADDR=:8080
# Docker 部署时健康检查映射到宿主机的端口；默认 18080；仅监听服务器回环地址。
HEALTH_HOST_PORT=18080
# 日志级别；默认 info；可选 debug、info、warn、error。
LOG_LEVEL=info
# New API 单次 HTTP 请求超时；默认 10s；支持 Go duration 格式。
NEWAPI_TIMEOUT=10s
# QQ HTTP API 单次请求超时；默认 10s；支持 Go duration 格式。
QQ_API_TIMEOUT=10s
# 额度提醒后台检查间隔；默认 10m；支持 Go duration 格式；间隔过短会增加 New API 请求频率。
NOTIFY_CHECK_INTERVAL=10m
# 每日用量摘要发送时间；默认 09:00；使用 CHECKIN_TIMEZONE 时区；格式必须为 HH:MM。
NOTIFY_DAILY_TIME=09:00
# 同一群主动通知最小间隔；默认 1m；支持 Go duration 格式；用于合并消息并控制发送频率。
NOTIFY_GROUP_COOLDOWN=1m
# 新成员欢迎默认文本；默认包含绑定引导；可通过 /welcome set 为各群单独覆盖；非敏感信息。
WELCOME_DEFAULT_MESSAGE=欢迎加入！如需使用机器人，请发送：/bind <邮箱或New API用户ID>
# Go 运行时软内存上限；Docker 默认 64MiB；可按实际负载调整。
GOMEMLIMIT=64MiB
# Go 垃圾回收目标百分比；Docker 默认 50；数值越低通常占用更少内存但消耗更多 CPU。
GOGC=50
