# QQ 机器人 AppID；必填；从 QQ 开放平台机器人管理页面获取；非敏感信息。
QQ_APP_ID=
# QQ 机器人 AppSecret/ClientSecret；必填；用于获取 QQ Access Token；敏感信息。
QQ_APP_SECRET=
# New API 服务根地址；必填；不要包含末尾斜杠，例如 https://example.com；非敏感信息。
NEWAPI_BASE_URL=https://example.com
# New API 管理员系统访问令牌；必填；用于用户查询、签到加额度和管理员额度管理；敏感信息。
NEWAPI_ADMIN_TOKEN=
# 上述 New API 管理员令牌所属用户 ID；必填；作为 New-Api-User 请求头；正整数。
NEWAPI_ADMIN_USER_ID=
# QQ 管理员 OpenID 名单；必填；多个值用英文逗号分隔，支持 union、user、member 标识；敏感信息。
QQ_ADMIN_OPENIDS=
# QQ 只读管理员 OpenID 名单；可选；这些身份可执行查询/报表类管理员命令，但不能修改机器人、QQ 或 New API 状态；多个值用英文逗号分隔。
QQ_READONLY_ADMIN_OPENIDS=
# 本地敏感数据加密密钥；必填；Base64 编码的 32 字节随机值；敏感信息。
BOT_DATA_KEY=
# SMTP 服务器地址；必填；用于发送绑定验证码；例如 smtp.example.com。
SMTP_HOST=
# SMTP 服务器端口；默认 587；应与 SMTP_TLS_MODE 匹配；正整数。
SMTP_PORT=587
# SMTP 登录用户名；必填；通常是完整邮箱地址；敏感信息。
SMTP_USERNAME=
# SMTP 登录密码或授权码；必填；敏感信息。
SMTP_PASSWORD=
# 验证邮件发件人地址；必填；可使用 Name <email@example.com> 格式；敏感信息。
SMTP_FROM=
# SMTP 加密方式；默认 starttls；可选 starttls、tls、none。
SMTP_TLS_MODE=starttls
# 是否启用直接加额度签到；默认 true；可选 true 或 false；非敏感信息。
CHECKIN_ENABLED=true
# 旧版固定签到额度；非必填；当前动态签到规则不再使用此值，仅保留旧部署兼容；非敏感信息。
CHECKIN_CREDIT=1
# 签到重置周期；默认 daily；可选 daily、weekly、monthly。
CHECKIN_PERIOD=daily
# 签到周期使用的时区；默认 Asia/Shanghai；必须为有效 IANA 时区。
CHECKIN_TIMEZONE=Asia/Shanghai
# 旧版兑换码签到有效期；默认 24h；当前直接加额度模式不使用，仅为兼容旧配置保留；非敏感信息。
CHECKIN_CODE_TTL=24h
# 签到、/help 和无效命令（未知指令、/help 格式错误、指令过长）的自动撤回延迟；默认 30s；
# 支持 Go duration 格式，例如 30s 或 1m；设为 0s 可禁用，同时撤回回复与触发指令。
# 仅对群聊生效（QQ 官方 API 只支持撤回群消息且仅限发送后 2 分钟内），私聊不受影响；非敏感信息。
CHECKIN_AUTO_RECALL_AFTER=30s
# 邮箱绑定验证码有效时间；默认 10m；支持 Go duration 格式。
BIND_CODE_TTL=10m
# 单次验证码最多允许的错误次数；默认 5；正整数。
BIND_CODE_MAX_ATTEMPTS=5
# 每个 QQ 身份及目标账户在限流窗口内最多成功发送的邮件数；默认 2；正整数。
BIND_EMAIL_LIMIT=2
# 邮箱验证码发送限流窗口；默认 1h；支持 Go duration 格式。
BIND_EMAIL_WINDOW=1h
# 旧版单聊与群聊关联码有效时间；默认 10m；当前纯群聊模式不使用，仅为兼容旧配置保留；非敏感信息。
LINK_CODE_TTL=10m
# 单次额度增加允许的最大站点显示额度；默认 1000；必须为正十进制数。
CREDIT_MAX_PER_COMMAND=1000
# bbolt 数据库文件路径；默认 /data/bot.db；目录必须可写并持久化挂载。
DATA_PATH=/data/bot.db
# 健康检查 HTTP 服务监听地址；默认监听全部网卡的 8080 端口。
LISTEN_ADDR=:8080
# Docker 部署时健康检查映射到宿主机的端口；默认 18080；仅监听服务器回环地址。
HEALTH_HOST_PORT=18080
# 日志级别；默认 info；可选 debug、info、warn、error。
LOG_LEVEL=info
# New API 单次 HTTP 请求超时；默认 30s；支持 Go duration 格式；站点负载较高时可适当增大。
NEWAPI_TIMEOUT=30s
# QQ HTTP API 单次请求超时；默认 10s；支持 Go duration 格式。
QQ_API_TIMEOUT=10s
# 额度提醒后台检查间隔；默认 10m；支持 Go duration 格式；间隔过短会增加 New API 请求频率。
NOTIFY_CHECK_INTERVAL=10m
# 是否启用用量图表命令；默认 true；当前部署设置为 false；可选 true 或 false；非敏感信息。
USAGE_CHART_ENABLED=false
# 是否启用额度提醒及每日摘要；默认 true；当前部署设置为 false；可选 true 或 false；非敏感信息。
NOTIFY_ENABLED=false
# 是否启用管理员 CSV 报表导出；默认 true；当前部署设置为 false；可选 true 或 false；非敏感信息。
ADMIN_REPORT_EXPORT_ENABLED=false
# 是否启用 New API 用户状态管理命令；默认 true；当前部署设置为 false；可选 true 或 false；非敏感信息。
ADMIN_USER_MANAGEMENT_ENABLED=false
# 是否启用管理员福利兑换码命令；默认 true；可选 true 或 false；非敏感信息。
BENEFIT_ENABLED=true
# 单次福利最多生成的兑换码数量；默认 100；范围 1-100；非敏感信息。
BENEFIT_MAX_COUNT=100
# 福利违规允许设置的最大封禁天数；默认 365；必须为正整数；非敏感信息。
BENEFIT_MAX_BAN_DAYS=365
# 福利领取检测及自动解封检查间隔；默认 1m；支持 Go duration 格式；非敏感信息。
BENEFIT_CHECK_INTERVAL=1m
# 是否启用 Codex 重置信号监测与补偿抽奖；选填；默认 true；可选 true 或 false；非敏感信息。
RESET_ENABLED=true
# Codex Reset timeline API 轮询间隔；选填；默认 3m；Go duration 格式且不能小于 1m；非敏感信息。
RESET_POLL_INTERVAL=3m
# Codex Reset timeline API 单次 HTTP 请求超时；选填；默认 20s；Go duration 格式且不超过 2m；非敏感信息。
RESET_HTTP_TIMEOUT=20s
# 允许处理的 timeline 重置事件最大年龄；选填；默认 24h；Go duration 格式且不超过 168h；用于避免部署后补发历史活动；非敏感信息。
RESET_SIGNAL_MAX_AGE=24h
# 新登记群的重置活动默认有效期；选填；默认 5h；Go duration 格式且不超过 168h；非敏感信息。
RESET_DEFAULT_DURATION=5h
# 新登记群的重置活动默认获奖人数；选填；默认 5；范围 1-100；非敏感信息。
RESET_DEFAULT_WINNERS=5
# 新登记群获奖者在活动开始前的默认用量补偿回溯时间；选填；默认 24h；活动进行中的用量不计入；Go duration 格式且不超过 744h；非敏感信息。
RESET_DEFAULT_LOOKBACK=24h
# 是否启用全球厂商状态自动监控；默认 true；关闭后 /vendor_status 查询仍可使用。
VENDOR_STATUS_ENABLED=true
# 初始主动告警群白名单；可选；逗号分隔 QQ 官方 group_openid；默认空，不主动发消息。
# /vendor_subscribe on|off 的覆盖设置存入 bbolt，重启后保持；不接受 AstrBot UMO。
VENDOR_STATUS_GROUP_WHITELIST=
# 厂商状态轮询间隔；默认 5m；不能小于 1m；必须为整秒 Go duration。
VENDOR_STATUS_POLL_INTERVAL=5m
# 单个公开状态 HTTP 请求超时；默认 15s；范围 1s–2m。
VENDOR_STATUS_HTTP_TIMEOUT=15s
# 每次查询/轮询 worker 的总执行时限；默认 10m；范围 30s–1h；已成功投递进度逐批保存。
VENDOR_STATUS_WORKER_TIMEOUT=10m
# Python 3.11+ 可执行文件或完整路径；默认 python；Docker 已包含依赖，本机需安装 requirements.txt。
VENDOR_STATUS_PYTHON=python
# 状态查询与后台采集专用代理；可选；支持 socks5/socks5h，可带 user:password@host:port。
# socks5 本地 DNS，socks5h 代理 DNS；凭据中的 @、:、# 等特殊字符请百分号编码。
# 不改变 QQ/New API/翻译请求；也可用 /vendor_config proxy 设置（加密持久化）、proxy off 关闭。
VENDOR_STATUS_PROXY=
# 是否推送计划维护；默认 false。
VENDOR_STATUS_NOTIFY_MAINTENANCE=false
# 首次成功采集时是否推送现有异常；默认 true；false 只建立初始基线。
VENDOR_STATUS_NOTIFY_EXISTING_ON_FIRST_STARTUP=true
# 已明确恢复事件的历史补报窗口；默认 24 小时；范围 0–168；0 关闭补报。
VENDOR_STATUS_HISTORY_LOOKBACK_HOURS=24
# 是否通知采集异常及恢复；默认 true；该恢复不代表厂商事故恢复。
VENDOR_STATUS_NOTIFY_SOURCE_FAILURES=true
# 连续不完整采集多少次后通知；默认 3；范围 1–100。
VENDOR_STATUS_SOURCE_FAILURE_THRESHOLD=3
# 同一来源/目标的采集异常通知冷却时间；默认 1h；范围 1m–24h；只在发送成功后计时。
VENDOR_STATUS_SOURCE_FAILURE_COOLDOWN=1h
# 图片语言；默认 bilingual；可选 bilingual、zh-CN、en-US。
VENDOR_STATUS_DISPLAY_LANGUAGE=bilingual
# 图片主题；默认 paper；可选 paper、midnight、porcelain、terminal、liquid_glass。
VENDOR_STATUS_CARD_THEME=paper
# 图片时区；默认跟随 CHECKIN_TIMEZONE；可填 IANA 名称；留空跟随宿主签到时区。
VENDOR_STATUS_TIMEZONE=Asia/Shanghai
# 自定义中文字体绝对路径；可选；默认查找微软雅黑/Noto CJK/苹方；Docker 已安装 Noto CJK。
VENDOR_STATUS_FONT_PATH=
# 是否使用已配置的模型翻译；默认 true；未配置模型或翻译失败时使用官方原文，不丢失告警。
VENDOR_STATUS_ENABLE_AI_TRANSLATION=true
# 翻译聊天模型 API 的 /v1 根地址；可选；这三项需一起配置，不自动使用 New API 管理员令牌。
# 若使用本站翻译，请单独创建普通模型 API Key；例：https://example.com/v1。
VENDOR_STATUS_TRANSLATION_BASE_URL=
# 翻译模型 API Key；可选；敏感信息；环境值不写入状态数据库，命令设置值仅加密保存。
VENDOR_STATUS_TRANSLATION_API_KEY=
# 翻译模型名称；可选。
VENDOR_STATUS_TRANSLATION_MODEL=
# JSON 高级配置文件路径；可选；用来停用单独状态源或添加自定义 Statuspage。
# 参考 vendor-status.example.json；Docker 建议放 ./data/vendor-status.json 并填 /data/vendor-status.json。
# 已明确设置的 VENDOR_STATUS_* 环境变量优先于 JSON 同名设置；不要将含真实密钥的 JSON 提交到 Git。
# /vendor_config 的持久化命令覆盖优先于环境变量和 JSON；用 /vendor_config reset <key|all> 恢复部署配置。
VENDOR_STATUS_CONFIG_PATH=
# 每日用量摘要发送时间；默认 09:00；使用 CHECKIN_TIMEZONE 时区；格式必须为 HH:MM。
NOTIFY_DAILY_TIME=09:00
# 同一群主动通知最小间隔；默认 1m；支持 Go duration 格式；用于合并消息并控制发送频率。
NOTIFY_GROUP_COOLDOWN=1m
# 新成员欢迎默认文本；默认包含绑定引导；可通过 /welcome set 为各群单独覆盖；非敏感信息。
WELCOME_DEFAULT_MESSAGE=欢迎加入！如需使用机器人，请发送：/bind <邮箱或New API用户ID>
# Go 运行时软内存上限；Docker 默认 64MiB；可按实际负载调整。
GOMEMLIMIT=64MiB
# Go 垃圾回收目标百分比；Docker 默认 50；数值越低通常占用更少内存但消耗更多 CPU。
GOGC=50
# Go 调度器逻辑处理器数量；Docker 默认 2；I/O 型机器人通常无需占满服务器全部 CPU。
GOMAXPROCS=2
